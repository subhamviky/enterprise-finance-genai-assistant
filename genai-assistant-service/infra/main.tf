# genai-assistant-service on Google Cloud, free tier only (hub design note GCP-01). Generated by A2C's
# IaCAgent (the untouched version is on the aidlc/genai-assistant-service branch), rewritten by hand for
# the landscape: Cloud Run scaled to zero with one instance, state in the landscape's one free Firestore
# database (collection "genai"), Cloud Run IAM identity for its callers, its own Google ID token to the
# four systems, Gemini's free tier with the key in Secret Manager. Apply ../../landscape/foundation and
# the four systems first. No secret is in this configuration or its state.

terraform {
  required_version = ">= 1.7"
  required_providers {
    google = {
      source  = "hashicorp/google"
      version = "~> 8.0"
    }
  }
}

provider "google" {
  project = var.project_id
  region  = var.region
}

locals {
  labels = { app = "genai-assistant-service", landscape = "finance-ai", managed-by = "terraform" }
  env = merge({
    GENAI_STATE_BACKEND          = "firestore"
    GENAI_FIRESTORE_COLLECTION   = "genai"
    FIRESTORE_DATABASE           = var.firestore_database
    GOOGLE_CLOUD_PROJECT         = var.project_id
    E2A_IDENTITY_SOURCE          = "gcp_cloud_run"
    E2A_IDENTITY_TRUSTED_ISSUERS = jsonencode(["https://accounts.google.com"])
    E2A_IDENTITY_SUBJECT_ROLES   = jsonencode(var.identity_subject_roles)
    E2A_WORKLOAD_IDENTITY        = "gcp_id_token"
    RECONCILIATION_API_URL       = var.reconciliation_api_url
    SETTLEMENT_API_URL           = var.settlement_api_url
    O2C_API_URL                  = var.o2c_api_url
    AUDIT_API_URL                = var.audit_api_url
    E2A_PROVIDER_PROFILE         = var.llm_profile
  }, var.llm_model_id == "" ? {} : { LLM_MODEL_ID = var.llm_model_id })
}

resource "google_service_account" "app" {
  account_id   = "genai-app"
  display_name = "genai-assistant-service runtime"
}

# Read and write documents (runs, approvals, claims) in Firestore; nothing else in the project.
resource "google_project_iam_member" "firestore" {
  project = var.project_id
  role    = "roles/datastore.user"
  member  = "serviceAccount:${google_service_account.app.email}"
}

resource "google_cloud_run_v2_service" "app" {
  name                = "genai-assistant-service"
  location            = var.region
  ingress             = "INGRESS_TRAFFIC_ALL" # IAM decides who may call; the service is never public
  deletion_protection = false
  labels              = local.labels

  template {
    service_account = google_service_account.app.email
    timeout         = "120s"
    scaling {
      min_instance_count = 0 # scale to zero: Always Free
      max_instance_count = var.max_instance_count
    }
    containers {
      image = var.image
      ports {
        container_port = 8000
      }
      resources {
        cpu_idle          = true # CPU only while a request is served
        startup_cpu_boost = true
        limits = {
          cpu    = "1"
          memory = "512Mi"
        }
      }
      dynamic "env" {
        for_each = local.env
        content {
          name  = env.key
          value = env.value
        }
      }
      # the Gemini Developer API key, only with the gemini_api profile (Secret Manager; never in state)
      dynamic "env" {
        for_each = var.gemini_api_key_secret == "" ? [] : [var.gemini_api_key_secret]
        content {
          name = "GEMINI_API_KEY"
          value_source {
            secret_key_ref {
              secret  = env.value
              version = "latest"
            }
          }
        }
      }
      startup_probe {
        http_get {
          path = "/health"
        }
      }
    }
  }
}

# Who may call the assistant: the people of the landscape (their Google accounts), nobody else.
resource "google_cloud_run_v2_service_iam_member" "invokers" {
  for_each = toset(var.invoker_members)
  name     = google_cloud_run_v2_service.app.name
  location = google_cloud_run_v2_service.app.location
  role     = "roles/run.invoker"
  member   = each.value
}

resource "google_secret_manager_secret_iam_member" "gemini_key" {
  count     = var.gemini_api_key_secret == "" ? 0 : 1
  secret_id = var.gemini_api_key_secret
  role      = "roles/secretmanager.secretAccessor"
  member    = "serviceAccount:${google_service_account.app.email}"
}

output "url" {
  value = google_cloud_run_v2_service.app.uri
}

output "service_account" {
  description = "Grant it run.invoker on, and roles in, the four systems (their identity_subject_roles)."
  value       = google_service_account.app.email
}
