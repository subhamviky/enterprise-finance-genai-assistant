# genai-assistant-service on Google Cloud (hub design note GCP-01): PLACEHOLDERS until cutover; the
# shared values are in landscape.vars. genai-assistant-service/infra reads these as TF_VAR_*.
GENAI_IMAGE=us-central1-docker.pkg.dev/finance-ai-landscape-PLACEHOLDER/landscape/genai-assistant-service:latest
# who may call the assistant (Cloud Run IAM), and what each may do (E2A v1.11.0)
INVOKER_MEMBERS=user:investigator-PLACEHOLDER@example.com,user:approver-PLACEHOLDER@example.com
IDENTITY_SUBJECT_ROLES={"investigator-PLACEHOLDER@example.com":["tenant:acme","investigator"],"approver-PLACEHOLDER@example.com":["tenant:acme","finance-approver"]}
