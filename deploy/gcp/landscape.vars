# The landscape on Google Cloud (hub design note GCP-01): the values every repository's binding shares.
# PLACEHOLDERS until the account exists; filled at cutover. Nothing secret belongs here (the Gemini key
# and the database password live in Secret Manager), which is why this is .vars, not .env.
# landscape/foundation and genai-assistant-service/infra read these as TF_VAR_*.

GCP_PROJECT_ID=finance-ai-landscape-PLACEHOLDER
# Always Free regions only (e2-micro, Firestore, Cloud Storage): us-west1, us-central1, us-east1
GCP_REGION=us-central1
GITHUB_OWNER=subhamviky
# empty: no budget alert. Its currency must be the billing account's (USD, EUR, INR, ...)
BILLING_ACCOUNT=
BUDGET_AMOUNT=1
BUDGET_CURRENCY=USD

# the landscape's image repository (landscape/foundation's output image_repository)
IMAGE_REPOSITORY=us-central1-docker.pkg.dev/finance-ai-landscape-PLACEHOLDER/landscape
# the project's one free Firestore database, shared; each service keeps its own collections
FIRESTORE_DATABASE=(default)

# the five services' Cloud Run URLs, known after their first apply
SETTLEMENT_API_URL=https://settlement-service-PLACEHOLDER.us-central1.run.app
AUDIT_API_URL=https://audit-ai-service-PLACEHOLDER.us-central1.run.app
RECONCILIATION_API_URL=https://reconciliation-service-PLACEHOLDER.us-central1.run.app
O2C_API_URL=https://o2c-agent-service-PLACEHOLDER.us-central1.run.app
GENAI_API_URL=https://genai-assistant-service-PLACEHOLDER.us-central1.run.app

# the services' identities (their infra/gcp creates them); each system grants them roles. REFERENCE VALUES:
# not Terraform inputs themselves; copy them into each repository's binding.vars (INVOKER_MEMBERS and the
# *IDENTITY_SUBJECT_ROLES maps), which landscape/tfvars.py turns into Terraform inputs
GENAI_SERVICE_ACCOUNT=genai-app@finance-ai-landscape-PLACEHOLDER.iam.gserviceaccount.com
O2C_SERVICE_ACCOUNT=o2c-agent-service-dev@finance-ai-landscape-PLACEHOLDER.iam.gserviceaccount.com
RECON_SERVICE_ACCOUNT=recon-app@finance-ai-landscape-PLACEHOLDER.iam.gserviceaccount.com
AUDIT_SERVICE_ACCOUNT=audit-app@finance-ai-landscape-PLACEHOLDER.iam.gserviceaccount.com

# the people: an investigator and an approver (two Google accounts: four eyes needs two people)
INVESTIGATOR=user:investigator-PLACEHOLDER@example.com
APPROVER=user:approver-PLACEHOLDER@example.com

# the model: simulated (no key) or gemini_api (free tier; the key in Secret Manager under this id)
E2A_PROVIDER_PROFILE=simulated
GEMINI_API_KEY_SECRET=gemini-api-key
LLM_MODEL_ID=
